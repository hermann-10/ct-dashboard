{
  "buildCommand": "npx ng build --configuration production",
  "outputDirectory": "dist/ct-dashboard/browser",
  "framework": null,
  "redirects": [
    { "source": "/go/:slug", "destination": "/api/go?slug=:slug", "statusCode": 307 }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
