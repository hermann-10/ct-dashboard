{
  "buildCommand": "npx ng build --configuration production",
  "outputDirectory": "dist/hervio-ops/browser",
  "framework": null,
  "crons": [
    {
      "path": "/api/check-notifications",
      "schedule": "0 8 * * *"
    }
  ],
  "redirects": [
    { "source": "/go/:slug", "destination": "/api/go?slug=:slug", "permanent": false }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
